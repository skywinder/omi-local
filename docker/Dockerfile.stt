# syntax=docker/dockerfile:1
FROM python:3.11.15-slim-trixie AS cpu
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY docker/requirements-stt.txt .
RUN pip install --no-cache-dir -r requirements-stt.txt
COPY --chown=10001:10001 docker/stt.py .
RUN useradd --create-home --uid 10001 omi && mkdir -p /models && chown omi:omi /models
USER omi
ENV HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1 PYTHONUNBUFFERED=1
CMD ["python", "stt.py"]

FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04 AS cuda
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY docker/requirements-stt.txt .
RUN pip3 install --no-cache-dir -r requirements-stt.txt
COPY --chown=10001:10001 docker/stt.py .
RUN useradd --create-home --uid 10001 omi && mkdir -p /models && chown omi:omi /models
USER omi
ENV HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1 PYTHONUNBUFFERED=1
CMD ["python3", "stt.py"]
