# Template. Prefer: bash scripts/local-mac.sh init-env
# That creates .env with mode 600 and a generated app key, without overwriting.
# Domain: https://dashboard.ngrok.com/domains
OMI_NGROK_URL=https://your-dev-domain.ngrok-free.app
# Agent credential: https://dashboard.ngrok.com/get-started/your-authtoken
# This token stays on the Mac and must never be sent to the iPhone.
NGROK_AUTHTOKEN=
# Generate with: bash scripts/local-mac.sh init-env
# This is a separate 43-character app key, not the ngrok authtoken.
OMI_LOCAL_APP_KEY=
