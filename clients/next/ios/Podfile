minimum_ios = '15.1'
platform :ios, minimum_ios
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
project 'Runner', {'Debug-dev' => :debug, 'Profile-dev' => :release, 'Release-dev' => :release}

generated = File.join(__dir__, 'Flutter', 'Generated.xcconfig')
sdk = File.foreach(generated).filter_map { |line| line[/^FLUTTER_ROOT=(.+)$/, 1] }.first
raise 'Run Flutter pub get before installing pods.' unless sdk
require File.join(sdk, 'packages/flutter_tools/bin/podhelper')
flutter_ios_podfile_setup

# Resolve the selected packages from pub's actual lock resolution. Flutter's default
# install_all helper also adds the cloud and wearable plugins of the donor app.
target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!
  flutter_install_ios_engine_pod(__dir__)
  plugins = JSON.parse(File.read(File.join(__dir__, '..', '.flutter-plugins-dependencies')))
  allowed = %w[audio_session flutter_secure_storage flutter_sound just_audio path_provider_foundation permission_handler_apple shared_preferences_foundation]
  resolved = plugins.fetch('plugins').fetch('ios').to_h { |p| [p.fetch('name'), p] }
  allowed.each do |name|
    p = resolved.fetch(name)
    folder = p.fetch('shared_darwin_source', false) ? 'darwin' : 'ios'
    source = File.join(p.fetch('path'), folder)
    raise "Missing podspec for #{name}" unless File.file?(File.join(source, name + '.podspec'))
    pod name, :path => source
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      settings = config.build_settings
      declared = settings['IPHONEOS_DEPLOYMENT_TARGET']
      if !declared || Gem::Version.new(declared) < Gem::Version.new(minimum_ios)
        settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios
      end
      if target.name == 'permission_handler_apple'
        settings['GCC_PREPROCESSOR_DEFINITIONS'] = ['$(inherited)', 'PERMISSION_MICROPHONE=1']
      end
    end
  end
end
